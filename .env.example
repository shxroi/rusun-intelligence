# Supabase project configuration
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=replace_with_a_rotated_secret_key

# Required by 00_pull_from_supabase.py.
# Use a read-only Postgres role/connection string from Supabase.
SUPABASE_DB_URL=postgresql://readonly_user:password@host:5432/postgres?sslmode=require

# Optional; useful when validating a JWT in a separate service.
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
